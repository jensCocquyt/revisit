# Copy to .env. Docker Compose and the server both read it.

POSTGRES_USER=revisit
POSTGRES_PASSWORD=revisit
POSTGRES_DB=revisit
POSTGRES_PORT=5432

DATABASE_URL=postgres://revisit:revisit@localhost:5432/revisit
# Integration tests and the eval each wipe their own database.
TEST_DATABASE_URL=postgres://revisit:revisit@localhost:5432/revisit_test
EVAL_DATABASE_URL=postgres://revisit:revisit@localhost:5432/revisit_eval

PORT=3000
# Google only redirects to plain http on localhost, so the server stays on this machine.
# LISTEN_HOST=127.0.0.1

# Sign-in: a Google OAuth client (Web application) with APP_URL/auth/callback as a redirect.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The only Google account that may sign in.
OWNER_EMAIL=
# Signs the session cookie; at least 32 characters. Changing it signs everyone out.
SESSION_SECRET=
# Where you open the app: http://localhost:5173 when using the Vite dev server.
APP_URL=http://localhost:3000

# Bedrock credentials come from the standard AWS chain (profile, SSO, env).
AWS_PROFILE=
AWS_REGION=eu-west-1

# Optional: the Claude model that reads screenshots (an eu. inference profile).
# SCREENSHOT_MODEL_ID=eu.anthropic.claude-haiku-4-5-20251001-v1:0
