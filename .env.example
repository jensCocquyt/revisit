# PostgreSQL (used by Docker Compose to provision the database)
POSTGRES_USER=revisit
POSTGRES_PASSWORD=revisit
POSTGRES_DB=revisit
POSTGRES_PORT=5432

# Connection string for tools running on the host (dbmate CLI, local dev servers).
# Inside Docker Compose the services build their own URL against the `postgres` host.
DATABASE_URL=postgres://revisit:revisit@localhost:5432/revisit?sslmode=disable

# TypeScript API
API_PORT=3000
# Optional static key for link routes (cloud spend protection). Unset = no
# key required, which is the local default.
# API_KEY=

# Python worker
# Enricher implementation: `stub` is the deterministic offline default.
ENRICHER=stub
# Seconds the worker sleeps between polls when no job was claimed.
WORKER_POLL_SECONDS=2
# Processing lease duration; an expired lease makes the job claimable again.
WORKER_LEASE_SECONDS=60
# Attempts before a job and its link are marked failed.
WORKER_MAX_ATTEMPTS=3

# Safe fetching limits (SSRF guard is always on; these bound the response).
FETCH_MAX_REDIRECTS=5
FETCH_MAX_BYTES=2000000
FETCH_TIMEOUT_SECONDS=15
FETCH_ALLOWED_CONTENT_TYPES=text/html,application/xhtml+xml,text/plain
# Test/CI only: hostnames allowed to resolve to private addresses (e.g. an
# in-compose fixture server). Leave empty outside CI.
FETCH_ALLOWED_HOSTS=

# Bedrock enricher (only used with ENRICHER=bedrock; credentials and region
# come from the standard AWS environment/credential chain, never this file).
BEDROCK_MODEL_ID=
