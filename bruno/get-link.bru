meta {
  name: Get link
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/links/{{linkId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  Returns the current stored representation of a link. Run "Save link" first:
  it captures the created id into {{linkId}}. Unknown ids return 404,
  malformed ids return 400.
}
