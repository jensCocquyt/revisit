meta {
  name: Get link
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/links/{{linkId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

docs {
  Returns the current stored representation of a link, including the `tags`
  and `deadline` facets of its latest enrichment. Run "Save link" first: it
  captures the created id into {{linkId}}. Unknown ids return 404, malformed
  ids return 400.
}
